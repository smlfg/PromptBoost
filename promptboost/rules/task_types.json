{
  "coding_patch": {
    "label": "Coding patch",
    "keywords": ["code", "repo", "repository", "bug", "fix", "patch", "test", "tests", "implement", "refactor", "api", "fastapi", "sqlite", "frontend", "backend"],
    "default_deliverables": ["Focused implementation", "Relevant tests or checks", "Verification summary"],
    "quality_gates": ["No unrelated refactors", "Existing behavior preserved", "Checks run or explained"]
  },
  "research_synthesis": {
    "label": "Research synthesis",
    "keywords": ["research", "compare", "synthesis", "sources", "citation", "cite", "latest", "evidence", "study", "paper"],
    "default_deliverables": ["Source-grounded synthesis", "Fact versus inference split", "Risks and open questions"],
    "quality_gates": ["Date-sensitive claims verified", "Sources identified", "Uncertainty preserved"]
  },
  "document_summary": {
    "label": "Document summary",
    "keywords": ["summarize", "summary", "document", "pdf", "article", "transcript", "notes", "source-faithful", "chunk"],
    "default_deliverables": ["Source-faithful summary", "Key points", "Unsupported or missing areas"],
    "quality_gates": ["No claims beyond source", "Coverage checked", "Ambiguity retained"]
  },
  "structured_extraction": {
    "label": "Structured extraction",
    "keywords": ["extract", "json", "schema", "fields", "csv", "table", "structured", "parse", "yaml"],
    "default_deliverables": ["Structured output", "Missing-value policy", "Field mapping notes"],
    "quality_gates": ["Valid format", "No invented fields", "Missing values explicit"]
  },
  "strategic_memo": {
    "label": "Strategic memo",
    "keywords": ["strategy", "memo", "roadmap", "decision", "tradeoff", "market", "positioning", "plan", "prioritize"],
    "default_deliverables": ["Decision memo", "Tradeoffs", "Risks", "Next actions"],
    "quality_gates": ["Assumptions explicit", "Actions concrete", "Generic filler avoided"]
  },
  "general_agent_task": {
    "label": "General agent task",
    "keywords": [],
    "default_deliverables": ["Completed requested output", "Assumptions and gaps", "Verification notes"],
    "quality_gates": ["Task intent preserved", "No unsupported facts", "Output is usable"]
  }
